{
  "name": "garimpu-finch",
  "version": "1.3.0",
  "description": "Aplicativo Windows para pesquisa de hotéis, imagens e CSV.",
  "main": "electron/main.js",
  "scripts": {
    "prestart": "npm run prepare:assets",
    "start": "node scraper.js",
    "dev": "npm run prepare:assets && electron .",
    "preelectron": "npm run prepare:assets",
    "electron": "electron .",
    "prepare:assets": "tailwindcss -i assets/tailwind-input.css -o public/vendor/tailwind.css --minify && node scripts/copy-vendor.js",
    "prepare:models": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-models.ps1",
    "prepare:models:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-models.ps1 -Force",
    "build:python": "npm run build:python:fast",
    "build:python:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python.ps1",
    "build:python:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python.ps1 -Clean",
    "prepare:dist": "npm run prepare:dist:fast",
    "prepare:dist:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -PrepareOnly",
    "prepare:dist:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -PrepareOnly -Clean",
    "build:win": "npm run build:win:fast",
    "build:win:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Target nsis",
    "build:win:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Target nsis -Clean",
    "build:portable": "npm run build:portable:clean",
    "build:portable:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Target portable -Clean",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Target nsis -Clean -Publish",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Target all -Clean",
    "check": "node --check scraper.js && node --check electron/main.js && node --check electron/configuracoes.js && node --check electron/preload.js && node --check electron/updater.js && node --check scripts/copy-vendor.js && node --check routes/buscar.routes.js && node --check routes/galeria.routes.js && node --check routes/organizacao.routes.js && node --check routes/logs.routes.js && node --check services/estimativa-florence.service.js && node --check services/filtro-download.service.js && node --check services/galeria.service.js && node --check services/localidades.service.js && node --check services/pastas-florence.service.js && node --check services/python-runtime.service.js && node --check services/organizador-python.service.js && node --check services/scraper.service.js && node --check services/log-broadcaster.service.js && node --check services/scraper/scraper-errors.js && node --check services/scraper/scraper-utils.js && node --check services/scraper/booking.provider.js && node --check services/scraper/expedia.provider.js && node --check state/status-organizacao.js && node --check public/js/tema.js && node --check public/js/navegacao.js && node --check public/js/configuracoes.js && node --check public/js/interface.js && node --check public/js/organizacao.js && node --check public/js/galeria.js && node --check public/js/busca.js && node --check public/js/terminal.js",
    "check:python": "python -m py_compile organizar_hoteis.py && python -m compileall -q python_organizador",
    "validate": "npm run check && npm test && npm run check:python",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaioTBarbieri/GarimpU-Finch.git"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CaioTBarbieri/GarimpU-Finch/issues"
  },
  "homepage": "https://github.com/CaioTBarbieri/GarimpU-Finch#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "open-location-code": "^1.0.3",
    "puppeteer": "^24.16.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.3",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.garimpu.finch",
    "productName": "GarimpU Finch",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "config/index.js",
      "public/**/*",
      "routes/**/*",
      "services/**/*",
      "state/**/*",
      "scraper.js",
      "package.json",
      "!**/*.map",
      "!**/*.test.js",
      "!**/__pycache__/**"
    ],
    "extraResources": [
      {
        "from": "resources/chromium",
        "to": "chromium",
        "filter": [
          "chrome/**/*"
        ]
      },
      {
        "from": "build/python-organizer",
        "to": "python-organizer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "Fotos exemplos",
        "to": "organizer-assets/Fotos exemplos",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "cache_embeddings_treino.npz",
        "to": "organizer-assets/cache_embeddings_treino.npz"
      },
      {
        "from": "yolov8n.pt",
        "to": "organizer-assets/yolov8n.pt"
      },
      {
        "from": "resources/huggingface",
        "to": "organizer-assets/huggingface",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "CaioTBarbieri",
        "repo": "GarimpU-Finch",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "GarimpU-Finch-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "GarimpU-Finch-Portable-${version}-${arch}.${ext}"
    }
  }
}
